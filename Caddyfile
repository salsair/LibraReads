:8080 {
    root * .
    php_fastcgi 127.0.0.1:9000
    file_server
    encode gzip
    
    # Handle PHP files
    @phpFiles {
        path *.php
    }
    
    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
    }
}